{
  "manifest_version": 3,
  "name": "Mail Link Defender",
  "description": "Analisa links em webmails e alerta sobre sinais de falsificação antes do clique.",
  "version": "0.2.1",
  "minimum_chrome_version": "127",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["entries/content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "entries/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Mail Link Defender",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
